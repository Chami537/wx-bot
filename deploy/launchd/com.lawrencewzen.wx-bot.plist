<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.lawrencewzen.wx-bot</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>set -a; [ -f "$HOME/.config/wx-bot/env" ] &amp;&amp; . "$HOME/.config/wx-bot/env"; exec /usr/local/bin/wx-bot run</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>~/Library/Logs/wx-bot.log</string>
  <key>StandardErrorPath</key>
  <string>~/Library/Logs/wx-bot.err</string>
</dict>
</plist>
